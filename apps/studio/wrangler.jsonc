{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "wicfl-studio",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "observability": { "enabled": true },
  // The interface is plain static files; the Worker only answers /api/*.
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": {
    "GITHUB_OWNER": "microsites-wicfl",
    "GITHUB_REPO": "wicfl-microsites",
    "GITHUB_BASE_BRANCH": "main",
    "PUBLISHED_SITES_HOST": "wicfl-microsites.workers.dev",
    // Cloudflare Access for this Worker (Zero Trust > Access > Applications > wicfl-studio).
    // Used to verify the Access token, because Workers with Static Assets do not receive ctx.access.
    // If the Zero Trust team name is ever renamed, ACCESS_TEAM_DOMAIN must change with it.
    "ACCESS_TEAM_DOMAIN": "https://flat-rain-592f.cloudflareaccess.com",
    "ACCESS_AUD": "61d64884938b6f84feaba58eb61d10d4230e0bb1811f7ee2aae99a73dc0f00f7"
  },
  // Local development only (`wrangler dev`): a fake Access identity through ctx.access. In production
  // ctx.access stays empty (Static Assets router) and src/access.js reads the Access token instead.
  "access": {
    "dev": {
      "aud": "wicfl-studio-dev",
      "identity": { "email": "vic@example.test" }
    }
  }
}
