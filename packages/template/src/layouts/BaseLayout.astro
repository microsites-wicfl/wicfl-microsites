---
interface HreflangAlternate {
  hreflang: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  pageType: "home" | "content" | "coverage";
  path: string;
  lang?: string;
  hreflangAlternates?: HreflangAlternate[];
  faqJsonLd?: string | null;
}

import { getCollection } from "astro:content";
import { routeForPageId, site } from "../lib/site-data.mjs";
import { FONT_FAMILIES, textOnPrimary } from "../../../config-schema/theme.mjs";

const {
  title,
  description = site.seo.description,
  pageType,
  path,
  lang = site.locale.primary,
  hreflangAlternates = [],
  faqJsonLd = null,
} = Astro.props;
const address = site.contact.address;
const audience = site.niche?.audience;
const product = site.niche?.product;
const kicker = product?.toLowerCase().startsWith(audience?.toLowerCase() ?? "")
  ? product
  : [audience, product].filter(Boolean).join(" ");
const canonicalUrl = `https://${site.domain}${path}`;
const navPages = (await getCollection("pages"))
  .filter((page) => page.data.pageType !== "home" && page.data.showInNav)
  .sort((a, b) => {
    const aOrder = a.data.navOrder;
    const bOrder = b.data.navOrder;
    if (aOrder === undefined && bOrder !== undefined) return 1;
    if (aOrder !== undefined && bOrder === undefined) return -1;
    if (aOrder !== undefined && bOrder !== undefined && aOrder !== bOrder) return aOrder - bOrder;
    return a.id.localeCompare(b.id);
  });
const legalPages = (await getCollection("pages"))
  .filter((page) => ["privacy-policy", "terms-of-use", "disclaimer"].includes(page.id))
  .sort((a, b) => ["privacy-policy", "terms-of-use", "disclaimer"].indexOf(a.id) - ["privacy-policy", "terms-of-use", "disclaimer"].indexOf(b.id));
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  name: site.brand.name,
  telephone: site.contact.trackingPhone,
  email: site.contact.email,
  ...(address ? { address: {
    "@type": "PostalAddress", streetAddress: address.street, addressLocality: address.city,
    addressRegion: address.state, postalCode: address.zip
  } } : {}),
  ...(site.geo.serviceArea ? { areaServed: site.geo.serviceArea } : {})
}).replace(/</g, "\\u003c");
type FontKey = keyof typeof FONT_FAMILIES;
const headingFont = (site.theme.headingFont ?? "georgia") as FontKey;
const bodyFont = (site.theme.bodyFont ?? "system-sans") as FontKey;
const webFonts = [...new Set([headingFont, bodyFont])]
  .map((font) => ({ key: font, ...FONT_FAMILIES[font] }))
  .filter((font): font is typeof font & { package: string; family: string } => Boolean(font.package && font.family));
const accentText = textOnPrimary(site.theme.accentColor);
const themeCss = [
  webFonts.map((font) => [400, 700].map((weight) => `@font-face{font-family:${font.family};font-style:normal;font-display:swap;font-weight:${weight};src:url(/fonts/${font.package}-latin-${weight}-normal.woff2) format("woff2")}`).join("")).join(""),
  bodyFont !== "system-sans" ? `:root{font-family:${FONT_FAMILIES[bodyFont].css}}` : "",
  headingFont !== "georgia" ? `.wordmark-name,h1,h2,h3,.footer-brand{font-family:${FONT_FAMILIES[headingFont].css}}` : "",
  site.theme.surfaceColor ? `:root{--variant-surface:${site.theme.surfaceColor}}` : "",
  site.theme.footerColor ? `.site-footer{background:${site.theme.footerColor}}` : "",
  site.theme.secondaryColor ? `.page-home .page-content::before,blockquote{border-color:${site.theme.secondaryColor}}.site-header{border-top-color:${site.theme.secondaryColor}}.icon{color:${site.theme.secondaryColor}}` : "",
].join("");
const headingFontDefinition = FONT_FAMILIES[headingFont];
const headingFontPackage = headingFontDefinition.package;
---

<!doctype html>
<html
  lang={lang}
  class:list={[`variant-${site.theme.variant}`, `page-${pageType}`]}
  style={`--site-accent: ${site.theme.accentColor}; --site-secondary: ${site.theme.secondaryColor ?? site.theme.accentColor}; --text-on-primary: ${accentText};`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.theme.accentColor} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {hreflangAlternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    {headingFontPackage && <link rel="preload" href={`/fonts/${headingFontPackage}-latin-700-normal.woff2`} as="font" type="font/woff2" crossorigin="anonymous" />}
    {themeCss && <style is:inline set:html={themeCss}></style>}
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
    {faqJsonLd && <script is:inline type="application/ld+json" set:html={faqJsonLd}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-content">
        <a class="wordmark" href="/">
          {site.brand.logo
            ? <img class="wordmark-logo" src={site.brand.logo} alt={site.brand.name} />
            : <span class="wordmark-name">{site.brand.name}</span>}
          {!site.brand.logo && kicker && <span class="wordmark-kicker">{kicker} insurance</span>}
        </a>
        <nav id="site-menu" class="site-nav" aria-label="Primary navigation">
          <a href="/" aria-current={path === "/" ? "page" : undefined}>Home</a>
          {navPages.map((page) => {
            const pagePath = routeForPageId(page.id);
            const isCurrentPage = Astro.url.pathname === pagePath;
            return (
              <a href={pagePath} aria-current={isCurrentPage ? "page" : undefined}>
                {page.data.navLabel ?? page.data.title}
              </a>
            );
          })}
          <a class="quote-link quote-link-menu" href="/contact/">Get a Quote</a>
        </nav>
        <div class="header-actions">
          <a class="phone-link" href={`tel:${site.contact.trackingPhone}`}>
            <svg class="icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4.5 3h2.8l1.2 3.6-1.7 1.4a10 10 0 0 0 5.2 5.2l1.4-1.7 3.6 1.2v2.8c0 .9-.8 1.6-1.7 1.5-6.1-.6-11-5.5-11.6-11.6C3 4 3.7 3 4.5 3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
            <span class="phone-text">{site.contact.displayPhone}</span>
          </a>
          <a class="quote-link quote-link-desktop" href="/contact/">Get a Quote</a>
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
            <span class="menu-toggle-icon" aria-hidden="true"></span><span class="visually-hidden">Menu</span>
          </button>
        </div>
      </div>
    </header>
    <main id="main-content" class="shell"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <section>
          {site.brand.logoOnDark
            ? <img class="footer-logo" src={site.brand.logoOnDark} alt={site.brand.name} />
            : <p class="footer-brand">{site.brand.name}</p>}
        </section>
        <section>
          <p class="footer-label">Quick Links</p>
          <p><a href="/">Home</a></p>
          {navPages.map((page) => <p><a href={routeForPageId(page.id)}>{page.data.navLabel ?? page.data.title}</a></p>)}
        </section>
        <section>
          <p class="footer-label">Service Areas</p>
          {site.geo.serviceArea.map((area: string) => <p>{area}</p>)}
        </section>
        <section>
          <p class="footer-label">Contact</p>
          <p><a href={`tel:${site.contact.trackingPhone}`}>{site.contact.displayPhone}</a></p>
          <p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
          <p>{site.geo.city}, {site.geo.state}</p>
          <p>Serving {site.geo.county} County</p>
        </section>
      </div>
      <div class="shell footer-bottom">
        <p>© {new Date().getFullYear()} {site.brand.name}. All rights reserved.</p>
        <div class="footer-legal">
          {legalPages.map((page) => <a href={routeForPageId(page.id)}>{page.data.title}</a>)}
          {address && <address>{address.street}, {address.city}, {address.state} {address.zip}</address>}
          {site.contact.licenseNumber && <span>Florida license: {site.contact.licenseNumber}</span>}
        </div>
      </div>
    </footer>
    <script is:inline>
      const header = document.querySelector(".site-header");
      const toggle = document.querySelector(".menu-toggle");
      const menu = document.querySelector("#site-menu");
      const headerContent = header?.querySelector(".header-content");
      const wordmark = header?.querySelector(".wordmark");
      const actions = header?.querySelector(".header-actions");
      if (header && toggle && menu && headerContent && wordmark && actions) {
        document.documentElement.classList.add("js");
        const closeMenu = () => { header.classList.remove("menu-open"); toggle.setAttribute("aria-expanded", "false"); };
        let naturalWidth = 0;
        const calculateNaturalWidth = () => {
          const wasCompact = header.classList.contains("is-compact");
          header.classList.remove("is-compact");
          const gap = Number.parseFloat(getComputedStyle(headerContent).gap) || 0;
          naturalWidth = wordmark.scrollWidth + menu.scrollWidth + actions.scrollWidth + (gap * 2);
          if (wasCompact) header.classList.add("is-compact");
        };
        const updateMode = () => {
          const narrowScreen = window.matchMedia("(max-width: 63.999rem)").matches;
          const compact = narrowScreen || naturalWidth > headerContent.clientWidth;
          header.classList.toggle("is-compact", compact);
          if (!compact) closeMenu();
        };
        calculateNaturalWidth();
        updateMode();
        new ResizeObserver(updateMode).observe(headerContent);
        document.fonts?.ready.then(() => { calculateNaturalWidth(); updateMode(); });
        toggle.addEventListener("click", () => {
          const open = header.classList.toggle("menu-open");
          toggle.setAttribute("aria-expanded", String(open));
        });
        document.addEventListener("keydown", (event) => { if (event.key === "Escape") closeMenu(); });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #12181f;
    --ink-soft: #2a3341;
    --muted: #5b6675;
    --surface: #fff;
    --line: #e2e6ec;
    --radius: .6rem;
    --radius-sm: .4rem;
    --shadow: 0 20px 44px -28px rgba(15, 23, 33, .28);
    --s0: .25rem; --s1: .5rem; --s2: 1rem; --s3: 1.5rem; --s4: 2.5rem; --s5: 4rem; --s6: 6rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: var(--ink);
    background: var(--surface);
    -webkit-font-smoothing: antialiased;
  }
  * { box-sizing: border-box; }
  /* A full-bleed block below is sized with 100dvw, which is measured before the browser's
     own scrollbar is subtracted, so it can be a few pixels wider than the visible viewport
     on a desktop with a classic (non-overlay) scrollbar. clip drops that sliver instead of
     turning it into a horizontal scrollbar: unlike hidden, it never creates a scrollable
     overflow region, so scrollWidth stays equal to clientWidth. */
  html { overflow-x: clip; }
  body { margin: 0; line-height: 1.7; }
  a { color: var(--site-accent); text-underline-offset: .18em; text-decoration-thickness: 1px; }
  a:hover { text-decoration-thickness: 2px; }
  a:focus-visible { outline: 3px solid var(--site-accent); outline-offset: 3px; border-radius: 2px; }
  .shell { width: min(100% - 2.5rem, 68rem); margin-inline: auto; }
  .site-header .shell { width: min(100% - 2.5rem, 100rem); }
  .skip-link { position: absolute; left: -9999px; }
  .skip-link:focus { left: 1rem; top: 1rem; z-index: 10; background: #fff; padding: var(--s2); border-radius: var(--radius-sm); box-shadow: var(--shadow); }

  .icon { width: 1.05em; height: 1.05em; display: inline-block; vertical-align: -.18em; margin-right: .35em; }

  .site-header {
    position: sticky; top: 0; z-index: 5;
    background: var(--variant-surface);
    border-top: .3rem solid var(--site-accent);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .header-content { display: flex; align-items: center; gap: var(--s3); min-height: 5.2rem; flex-wrap: wrap; }
  .wordmark { display: flex; flex-direction: column; gap: .1rem; color: var(--ink); text-decoration: none; line-height: 1.15; }
  .wordmark-name { font-family: Georgia, "Iowan Old Style", "Palatino Linotype", serif; font-size: 1.4rem; font-weight: 700; letter-spacing: -.01em; }
  .wordmark-logo { height: 3.5rem; width: auto; max-width: 220px; display: block; }
  .wordmark-kicker { font-size: .72rem; font-weight: 600; letter-spacing: .09em; text-transform: uppercase; color: var(--site-accent); }
  .site-nav { display: flex; align-items: center; flex: 1; justify-content: center; gap: .2rem; min-width: 0; }
  .site-nav a { border-radius: 999px; color: var(--ink-soft); font-size: .88rem; font-weight: 700; line-height: 1.25; padding: .35rem .65rem; text-decoration: none; white-space: nowrap; }
  .site-nav a:hover { background: rgba(15, 23, 33, .08); }
  .site-nav a[aria-current="page"] { background: var(--site-accent); color: var(--text-on-primary); }
  .header-actions { display: flex; align-items: center; gap: var(--s1); }
  .phone-link { display: inline-flex; align-items: center; color: var(--ink-soft); font-weight: 700; padding: .5rem; text-decoration: none; white-space: nowrap; }
  .phone-link .icon { color: var(--site-accent); }
  .quote-link, .button-link { display: inline-flex; align-items: center; justify-content: center; background: var(--site-accent); border-radius: 999px; color: var(--text-on-primary); font-weight: 700; padding: .6rem 1.1rem; text-decoration: none; box-shadow: 0 10px 22px -14px rgba(0,0,0,.35); transition: transform .15s ease, box-shadow .15s ease; }
  .quote-link:hover, .button-link:hover { color: var(--text-on-primary); transform: translateY(-1px); box-shadow: 0 14px 26px -14px rgba(0,0,0,.4); }
  .quote-link-menu, .menu-toggle { display: none; }
  .button-link-wrap { margin-block: var(--s3); }
  .menu-toggle { appearance: none; border: 0; background: transparent; color: var(--ink); padding: .5rem; }
  .menu-toggle-icon, .menu-toggle-icon::before, .menu-toggle-icon::after { display: block; width: 1.35rem; height: 2px; background: currentColor; border-radius: 999px; content: ""; }
  .menu-toggle-icon { position: relative; }
  .menu-toggle-icon::before { position: absolute; top: -.42rem; }
  .menu-toggle-icon::after { position: absolute; top: .42rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  main { min-height: 55vh; padding-block: var(--s6) var(--s5); }
  /* W-115: scoped to main, not a bare .page-content selector — pageType "content" produces
     an identically-named page-content class on <html> (see class:list above), and a bare
     selector here would clip the whole page to this width instead of just the article. */
  main .page-content { max-width: 46rem; }
  .page-home .page-content { max-width: 60rem; padding-left: var(--s4); --content-inset: var(--s4); position: relative; }
  .page-home .page-content::before { content: ""; position: absolute; left: 0; top: .3em; bottom: .3em; width: .3rem; background: var(--site-accent); border-radius: 999px; }
  .page-home .page-content.has-full-block::before { display: none; }
  .page-coverage .page-content { padding-top: var(--s2); border-top: 2px solid var(--line); }
  main .page-content img { display: block; max-width: 100%; height: auto; }

  h1, h2, h3 { font-family: Georgia, "Iowan Old Style", "Palatino Linotype", serif; color: var(--ink); line-height: 1.15; letter-spacing: -.01em; }
  h1 { font-size: clamp(2.1rem, 4.6vw, 3.6rem); margin: 0 0 var(--s3); }
  h2 { font-size: clamp(1.4rem, 2.6vw, 2rem); margin: var(--s5) 0 var(--s2); }
  h3 { font-size: 1.2rem; margin: var(--s4) 0 var(--s1); }
  p, li, td, th { font-size: 1.05rem; color: var(--ink-soft); }
  .page-content > p:first-of-type { font-size: 1.18rem; color: var(--muted); }

  blockquote { border-left: .3rem solid var(--site-accent); background: var(--variant-surface); color: var(--ink-soft); margin: var(--s4) 0; padding: var(--s3); border-radius: 0 var(--radius) var(--radius) 0; font-size: 1.08rem; }
  blockquote p:last-child { margin-bottom: 0; }

  code { background: #eef1f5; border-radius: .25rem; padding: .15rem .4rem; font-size: .92em; }
  pre { overflow-x: auto; padding: var(--s3); background: #14181f; color: #eef1f5; border-radius: var(--radius); }
  pre code { background: none; padding: 0; }

  table { border-collapse: separate; border-spacing: 0; display: block; max-width: 100%; overflow-x: auto; margin: var(--s3) 0; border: 1px solid var(--line); border-radius: var(--radius-sm); }
  th, td { padding: .75rem 1rem; text-align: left; border-bottom: 1px solid var(--line); }
  tr:last-child td { border-bottom: none; }
  th { background: var(--variant-surface); font-weight: 700; }
  tbody tr:nth-child(even) td { background: rgba(15, 23, 33, .035); }

  ul, ol { padding-left: 1.3em; }
  li { margin-bottom: .4em; }

  .site-footer { background: var(--ink); color: #eef1f5; padding-block: var(--s5) var(--s3); margin-top: var(--s6); }
  .site-footer a { color: #fff; }
  .site-footer a:hover { text-decoration-thickness: 2px; }
  .footer-grid { display: grid; gap: var(--s4); grid-template-columns: 1.2fr repeat(3, 1fr); }
  .footer-brand { font-family: Georgia, "Iowan Old Style", "Palatino Linotype", serif; font-size: 1.2rem; font-weight: 700; margin: 0 0 var(--s1); }
  .footer-logo { height: 3.5rem; width: auto; max-width: 220px; display: block; }
  .footer-label { text-transform: uppercase; letter-spacing: .08em; font-size: .72rem; color: rgba(238, 241, 245, .6); margin: 0 0 var(--s2); font-weight: 700; }
  .site-footer p { margin: 0 0 .5rem; color: rgba(238, 241, 245, .88); }
  address { font-style: normal; }
  .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s2) var(--s4); border-top: 1px solid rgba(238, 241, 245, .24); margin-top: var(--s4); padding-top: var(--s2); }
  .footer-bottom > p, .footer-legal { font-size: .85rem; color: rgba(238, 241, 245, .78); }
  .footer-legal { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s2); align-items: baseline; }
  .block-hero,
  .block-features.block-dark,
  .block-cta {
    /* margin-left: calc(50% - 50dvw) only breaks out flush when its containing block sits
       exactly centered in the viewport. .page-content is not: .page-home adds a left-only
       padding for the accent bar, and its own max-width can be narrower than .shell's, so a
       plain percentage-based breakout drifted off one edge or the other depending on the
       viewport. --shell-inset and --content-inset (set on .page-content) reconstruct the
       real distance from the viewport edge instead of approximating it with a percentage. */
    --shell-inset: calc((100dvw - min(100dvw - 2.5rem, 68rem)) / 2);
    width: 100dvw;
    margin-block: var(--s5);
    margin-left: calc(-1 * (var(--shell-inset) + var(--content-inset, 0px)));
    padding: var(--s5) max(1.25rem, calc((100dvw - 68rem) / 2));
    position: relative;
    color: #fff;
    overflow: hidden;
  }
  .block-hero,
  .block-cta {
    background: var(--ink);
    min-height: 30rem;
    display: grid;
    align-items: center;
  }
  /* Specificity is resolved per declaration, not per rule: main .page-content img's
     height: auto (one class, two type selectors) still beat a plain .block-bleed-media
     (one class) for the height property alone, even though position/inset came through
     fine. :is(.block-hero, .block-cta) .block-bleed-media counts two classes on every
     branch, which outranks it. Without this, the photo fell back to its intrinsic aspect
     ratio and, at widths where width × ratio came in under the section's min-height, left
     a bare strip at the bottom (seen at 768px). */
  :is(.block-hero, .block-cta) .block-bleed-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .block-hero::after,
  .block-cta:not(.block-cta-plain)::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--ink) 0%, color-mix(in srgb, var(--ink) 82%, transparent) 58%, transparent 100%);
  }
  .block-hero-content {
    position: relative;
    z-index: 1;
    max-width: 42rem;
  }
  .block-hero h1,
  .block-hero h2,
  .block-hero p,
  .block-dark h2,
  .block-dark h3,
  .block-dark p,
  .block-cta h2,
  .block-cta p {
    color: #fff;
  }
  .block-eyebrow {
    margin: 0 0 var(--s1);
    text-transform: uppercase;
    font-size: .75rem;
    letter-spacing: .12em;
    font-weight: 700;
  }
  .block-features,
  .block-cards {
    margin-block: var(--s5);
    padding: var(--s4);
    background: var(--variant-surface);
  }
  .block-features .block-inner,
  .block-cards .block-inner {
    display: grid;
    gap: var(--s3);
    max-width: 68rem;
    margin: auto;
  }
  /* The grid follows the real item count (2, 3 or 4) instead of a fixed column count, so
     4 items never split into an awkward 3 + 1. */
  .block-inner[data-items="2"] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .block-inner[data-items="3"] {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .block-inner[data-items="4"] {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  /* .block-intro is one grid item that lays out its own children (eyebrow, heading, intro
     paragraph) with normal block-flow margins, which collapse; a bare CSS grid never
     collapses margins between its own items, which is what pushed these apart before. */
  .block-intro {
    grid-column: 1 / -1;
  }
  .block-intro h2 {
    margin: 0 0 var(--s2);
  }
  .block-intro p {
    margin: 0;
  }
  .block-features-item,
  .block-cards-item {
    min-width: 0;
    position: relative;
  }
  .block-features-item {
    padding: var(--s2);
  }
  /* The divider marks the space between items, so the first item does not carry one on
     its own leading edge. :first-of-type is scoped to the <article> tag: block-intro (a
     <div>) sits before the items, so a plain :first-child never matches any of them. */
  .block-features:not(.block-dark) .block-features-item:not(:first-of-type) {
    border-left: 1px solid var(--line);
  }
  .block-features:not(.block-dark) .block-features-item {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--s2);
