---
import { getEntry, getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, hreflangAlternatesFor, localeOfPageId, faqPageJsonLd } from "../lib/site-data.mjs";

// W-022: the primary locale's content always lives flat at content/index.md (id "index"),
// bilingual or not, so "/" always serves it. Alternate locales get their own prefixed home at
// [...slug].astro (e.g. "/es/"), never a duplicate of this page.
const page = await getEntry("pages", "index");
if (!page) throw new Error("Missing required content page: index.md");
const { Content, remarkPluginFrontmatter } = await render(page);
const hasHero = remarkPluginFrontmatter.hasHero === true;
const hasFullBlock = remarkPluginFrontmatter.hasFullBlock === true;
const faqJsonLd = faqPageJsonLd(remarkPluginFrontmatter.faq);
const allPages = await getCollection("pages");
const hreflangAlternates = hreflangAlternatesFor(page.id, allPages);
---

<BaseLayout
  title={site.seo.title}
  pageTitle={page.data.title}
  pageId={page.id}
  description={page.data.description ?? site.seo.description}
  pageType={page.data.pageType}
  path="/"
  lang={localeOfPageId(page.id)}
  navLabel={page.data.navLabel}
  serviceName={page.data.serviceName}
  hreflangAlternates={hreflangAlternates}
  faqJsonLd={faqJsonLd}
>
  <article class:list={["page-content", { "has-full-block": hasFullBlock }]}>
    {!hasHero && <h1>{page.data.title}</h1>}
    <Content />
  </article>
</BaseLayout>
