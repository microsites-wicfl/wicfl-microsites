---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../lib/site-data.mjs";
const page = await getEntry("pages", "index");
if (!page) throw new Error("Missing required content page: index.md");
const { Content } = await render(page);
---
<BaseLayout title={site.seo.title} description={page.data.description ?? site.seo.description} pageType={page.data.pageType}>
  <article class="page-content"><h1>{page.data.title}</h1><Content /></article>
</BaseLayout>
