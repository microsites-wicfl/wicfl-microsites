---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pages, site } from "../lib/site-data.mjs";

export function getStaticPaths() {
  return pages
    .filter((page) => page.route !== "/")
    .map((page) => ({ params: { slug: page.route.slice(1, -1) }, props: { page } }));
}

const { page } = Astro.props;
---

<BaseLayout title={`${page.title} | ${site.brand.name}`} description={site.seo.description}>
  <h1>{page.title}</h1>
  <Fragment set:html={page.html} />
</BaseLayout>
