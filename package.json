{
  "name": "wicfl-microsites",
  "version": "0.1.0",
  "private": true,
  "description": "WICFL insurance microsite factory monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-site.mjs _example",
    "build": "npm run build:site -- _example",
    "build:site": "node scripts/build-site.mjs",
    "build:pod": "node scripts/build-pod.mjs",
    "check": "npm run validate:configs && npm run check:types && node --test scripts/check-production-config.test.mjs scripts/remark-columns.test.mjs",
    "check:types": "node scripts/check-types.mjs",
    "check:production": "node scripts/check-production-config.mjs",
    "validate:configs": "ajv validate --spec=draft2020 -s packages/config-schema/site.config.schema.json -d \"packages/config-schema/examples/*.json\" -d \"sites/*/site.config.json\""
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "ajv-cli": "^5.0.0",
    "astro": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  }
}
